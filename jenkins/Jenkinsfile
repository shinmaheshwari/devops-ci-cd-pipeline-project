// Sprint 4: adds the Deploy stage — updates kubeconfig, installs metrics-server
// (required for HPA, not included by default on EKS), applies manifests with
// the just-built image tag, waits for rollout, and smoke-tests the endpoint.
// Sprint 5 will add monitoring; this is the last stage before that.

pipeline {
    agent any

    environment {
        AWS_REGION   = 'ap-south-1'
        ECR_REPO     = 'devops-capstone-app'
        ECR_REGISTRY = '562904760755.dkr.ecr.ap-south-1.amazonaws.com'
        IMAGE_TAG    = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'local'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -input=false -out=tfplan'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -input=false -auto-approve tfplan'
                }
            }
        }

        stage('Ansible Configure') {
            steps {
                dir('ansible') {
                    sh '''
                        which ansible-playbook || sudo apt-get install -y ansible
                        EKS_CLUSTER=$(cd ../terraform && terraform output -raw eks_cluster_name)
                        ANSIBLE_ROLES_PATH=roles ansible-playbook site.yml \
                            -e aws_region=${AWS_REGION} \
                            -e eks_cluster_name="${EKS_CLUSTER}"
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh '''
                        python3 -m venv .venv
                        . .venv/bin/activate
                        pip install --no-cache-dir -r requirements.txt pytest
                        pytest -q
                    '''
                }
            }
        }

        stage('Build image') {
            steps {
                dir('app') {
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPO}:latest
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:latest
                """
            }
        }

        stage('Deploy') {
            steps {
                dir('terraform') {
                    sh 'aws eks update-kubeconfig --name $(terraform output -raw eks_cluster_name) --region ${AWS_REGION}'
                }
                dir('kubernetes') {
                    sh '''
                        # metrics-server is required for HPA and is NOT included by
                        # default on EKS. Applying it here is idempotent — safe to
                        # run on every deploy.
                        kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

                        kubectl apply -f namespace.yaml
                        kubectl apply -f deployment.yaml
                        kubectl apply -f service.yaml
                        kubectl apply -f hpa.yaml

                        # Swap in the image just built and pushed, rather than
                        # whatever tag is checked into deployment.yaml.
                        kubectl set image deployment/capstone-app \
                            capstone-app=${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
                            -n capstone-app

                        kubectl rollout status deployment/capstone-app -n capstone-app --timeout=180s
                    '''
                }
            }
        }

        stage('Post-deploy smoke test') {
            steps {
                sh '''
                    SERVICE_HOST=""
                    for i in $(seq 1 20); do
                        SERVICE_HOST=$(kubectl get svc capstone-app -n capstone-app \
                            -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                        if [ -n "$SERVICE_HOST" ]; then break; fi
                        echo "Waiting for LoadBalancer hostname... ($i/20)"
                        sleep 15
                    done

                    if [ -z "$SERVICE_HOST" ]; then
                        echo "LoadBalancer hostname not assigned in time"
                        exit 1
                    fi

                    echo "Service reachable at http://${SERVICE_HOST}"
                    # ELB DNS propagation can lag even after the hostname appears
                    sleep 30
                    curl -sf --max-time 10 "http://${SERVICE_HOST}/health"
                '''
            }
        }
    }

    post {
        success {
            echo "Deployed ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} to EKS"
        }
        failure {
            echo "Build failed — check the stage logs above."
        }
    }
}
