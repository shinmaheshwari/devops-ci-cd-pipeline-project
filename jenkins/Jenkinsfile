// Sprint 2: adds Terraform provisioning before build/test/push.
// Sprint 3 will add an Ansible config stage after Terraform.
// Sprint 4 converges everything into one declarative pipeline
// (Build -> Infra -> Config -> Deploy -> Monitor).

pipeline {
    agent any

    environment {
        AWS_REGION   = 'ap-south-1'
        ECR_REPO     = 'devops-capstone-app'
        ECR_REGISTRY = '562904760755.dkr.ecr.ap-south-1.amazonaws.com'
        IMAGE_TAG    = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'local'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -input=false -out=tfplan'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    // -auto-approve is fine here since Plan already ran and
                    // produced the exact plan file being applied. For a
                    // stricter setup, add an `input` approval step before
                    // this instead.
                    sh 'terraform apply -input=false -auto-approve tfplan'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh '''
                        python3 -m venv .venv
                        . .venv/bin/activate
                        pip install --no-cache-dir -r requirements.txt pytest
                        pytest -q
                    '''
                }
            }
        }

        stage('Build image') {
            steps {
                dir('app') {
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} \
                        | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPO}:latest
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:latest
                """
            }
        }
    }

    post {
        success {
            echo "Infra applied and pushed ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "Build failed — check the stage logs above."
        }
    }
}

